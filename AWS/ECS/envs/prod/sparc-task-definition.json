{
  "_README": "SPARC task-definition variables (#507). Terraform renders this via templatefile() into the ECS task def. LITERAL values are safe to edit per deployment. Values shown as Terraform tokens (dollar-brace placeholders) are injected by Terraform (infra-derived: DB/Redis/S3/region/ARNs) and must NOT be edited. 'secrets' hold ONLY Secrets Manager references (valueFrom), never secret values.",
  "environment": {
    "ACTIVE_STORAGE_SERVICE": "amazon",
    "AWS_BUCKET": "${s3_bucket_name}",
    "AWS_REGION": "${aws_region}",
    "FORCE_SSL": "true",
    "MALLOC_ARENA_MAX": "2",
    "PORT": "${rails_port}",
    "RAILS_ENV": "production",
    "REDIS_URL": "${redis_url}",
    "SOLID_QUEUE_IN_PUMA": "true",
    "SPARC_ADMIN_CREDENTIALS_SECRET_ARN": "${admin_credentials_secret_arn}",
    "SPARC_ADMIN_EMAIL": "admin@example.com",
    "SPARC_ADMIN_REFRESH_ENABLED": "true",
    "SPARC_API_AUTH": "hybrid",
    "SPARC_APP_NAME": "SPARC",
    "SPARC_APP_URL": "https://sparc.example.com",
    "SPARC_ARTIFACT_COPY_PER_VERSION": "false",
    "SPARC_ARTIFACT_REAPER_PURGE": "false",
    "SPARC_AUTHORITATIVE_FETCH_ENABLED": "false",
    "SPARC_AWS_IAM_DB_AUTH": "false",
    "SPARC_AWS_LABS_CDEF_BRANCH": "main",
    "SPARC_AWS_LABS_CDEF_ENABLED": "true",
    "SPARC_AWS_LABS_CDEF_REFRESH_INTERVAL_DAYS": "7",
    "SPARC_AWS_LABS_CDEF_REPO": "awslabs/oscal-content-for-aws-services",
    "SPARC_BANNER": "file:public/banners/demo-banner.html",
    "SPARC_CCI_REVS": "4,5",
    "SPARC_CONTACT_EMAIL": "support@example.com",
    "SPARC_DB_HOST": "${db_host}",
    "SPARC_DB_NAME": "${db_name}",
    "SPARC_DB_PORT": "${db_port}",
    "SPARC_DB_SSLMODE": "require",
    "SPARC_ENABLE_LDAP": "false",
    "SPARC_ENABLE_LOCAL_LOGIN": "true",
    "SPARC_ENABLE_OIDC": "true",
    "SPARC_ENABLE_PIV": "${sparc_enable_piv}",
    "SPARC_ENABLE_SMTP": "true",
    "SPARC_ENABLE_USER_REGISTRATION": "false",
    "SPARC_FIDO2_ENABLED": "true",
    "SPARC_PIV_ACCEPTED_ISSUERS": "${sparc_piv_accepted_issuers}",
    "SPARC_PIV_CERT_HEADER": "X-SSL-Client-Cert",
    "SPARC_PIV_IDENTITY_SOURCE": "${sparc_piv_identity_source}",
    "SPARC_REQUIRE_AUTH_METHODS": "${sparc_require_auth_methods}",
    "SPARC_GITHUB_CLIENT_ID": "Ov0000000000000000000",
    "SPARC_GITLAB_CLIENT_ID": "",
    "SPARC_GITLAB_SITE": "https://gitlab.com",
    "SPARC_HEADER_HIGHLIGHT_COLOR": "",
    "SPARC_HEADER_TEXT": "SPARC \u2014 Testing / Demonstration Environment",
    "SPARC_HEADER_TEXT_COLOR": "",
    "SPARC_INACTIVITY_DAYS": "30",
    "SPARC_LDAP_ATTRIBUTE": "sAMAccountName",
    "SPARC_LDAP_BASE": "",
    "SPARC_LDAP_BIND_DN": "",
    "SPARC_LDAP_ENCRYPTION": "simple_tls",
    "SPARC_LDAP_HOST": "",
    "SPARC_LDAP_PORT": "636",
    "SPARC_LOG_LEVEL": "info",
    "SPARC_LOG_TO_STDOUT": "true",
    "SPARC_MAX_AVATAR_MB": "2",
    "SPARC_MAX_UPLOAD_MB": "100",
    "SPARC_OIDC_CLIENT_ID": "0oa00000000000000000",
    "SPARC_OIDC_FORCE_MFA": "true",
    "SPARC_OIDC_ISSUER_URL": "https://integrator-0000000.okta.com/oauth2/default",
    "SPARC_OIDC_PROVIDER_TITLE": "Okta",
    "SPARC_OIDC_REDIRECT_URI": "https://sparc.example.com/auth/oidc/callback",
    "SPARC_OIDC_SCOPES": "openid profile email",
    "SPARC_ORG_ADDRESS": "",
    "SPARC_ORG_CONTACT_PERSON": "",
    "SPARC_ORG_DESCRIPTION": "SPARC is supported by private development and is made available for testing purposes only.",
    "SPARC_ORG_NAME": "Risk Sentinel",
    "SPARC_OSCAL_ORG_NAME": "Risk Sentinel",
    "SPARC_PASSWORD_EXPIRY_DAYS": "30",
    "SPARC_PRINT_ROTATED_PASSWORD": "",
    "SPARC_PROCESSING_STUCK_MINUTES": "5",
    "SPARC_PUBLIC_CATALOGS": "true",
    "SPARC_RATE_LIMIT_API_WRITES_PER_MINUTE": "600",
    "SPARC_RATE_LIMIT_LOGIN_FAILURES_PER_MIN": "3",
    "SPARC_RATE_LIMIT_UPLOADS_PER_5MIN_PER_IP": "60",
    "SPARC_RATE_LIMIT_UPLOADS_PER_HOUR_PER_USER": "500",
    "SPARC_REQUIRE_DOCUMENT_APPROVAL": "true",
    "SPARC_RUN_SEEDS": "false",
    "SPARC_SEED_MODE": "full",
    "SPARC_SESSION_MAX_HOURS": "8",
    "SPARC_SESSION_TIMEOUT_MINUTES": "60",
    "SPARC_SKIP_DEFERRED_DATA_MIGRATIONS": "false",
    "SPARC_SMTP_ADDRESS": "smtp.mail.us-east-1.awsapps.com",
    "SPARC_SMTP_AUTH": "login",
    "SPARC_SMTP_FROM_ADDRESS": "noreply@example.com",
    "SPARC_SMTP_PORT": "465",
    "SPARC_SMTP_STARTTLS_AUTO": "true",
    "SPARC_SMTP_USERNAME": "admin@example.com",
    "SPARC_STRUCTURED_LOGGING": "true",
    "SPARC_USERDATA_HOST": "sparc.example.com",
    "SPARC_WELCOME_TEXT": "Welcome to SPARC"
  },
  "secrets": {
    "SECRET_KEY_BASE": "${app_secret_arn}:SECRET_KEY_BASE::",
    "SPARC_ADMIN_PASSWORD": "${admin_credentials_secret_arn}:sparc_admin_password::",
    "SPARC_AWS_LABS_GITHUB_TOKEN": "${app_secret_arn}:SPARC_AWS_LABS_GITHUB_TOKEN::",
    "SPARC_DB_PASSWORD": "${db_secret_arn}:password::",
    "SPARC_DB_USER": "${db_secret_arn}:username::",
    "SPARC_GITHUB_CLIENT_SECRET": "${app_secret_arn}:SPARC_GITHUB_CLIENT_SECRET::",
    "SPARC_GITLAB_CLIENT_SECRET": "${app_secret_arn}:SPARC_GITLAB_CLIENT_SECRET::",
    "SPARC_HASH": "${sparc_hash_secret_arn}",
    "SPARC_LDAP_BIND_PASSWORD": "${app_secret_arn}:SPARC_LDAP_BIND_PASSWORD::",
    "SPARC_OIDC_CLIENT_SECRET": "${app_secret_arn}:SPARC_OIDC_CLIENT_SECRET::",
    "SPARC_SMTP_PASSWORD": "${app_secret_arn}:SPARC_SMTP_PASSWORD::"
  }
}
