# ============================================================================
# SPARC EC2 — Production Environment
# ============================================================================
# cp envs/prod/terraform.tfvars.example terraform.tfvars
# ============================================================================

environment  = "prod"
aws_region   = "us-east-1"
project_name = "sparc"

# ── Container Images ───────────────────────────────────────────────────────
app_image   = "123456789012.dkr.ecr.us-east-1.amazonaws.com/sparc:v1.0.0"
nginx_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/sparc-nginx:v1.0.0"

# ── EC2 ────────────────────────────────────────────────────────────────────
instance_type    = "t3.large"
root_volume_size = 30

# ── EBS ────────────────────────────────────────────────────────────────────
ebs_volume_size = 100

# ── TLS Certificate ────────────────────────────────────────────────────────
create_certificate = true

# ── Route 53 ──────────────────────────────────────────────────────────────
hosted_zone_id = "Z0123456789ABCDEFGHIJ"
domain_name    = "sparc.example.com"

# ── RDS ────────────────────────────────────────────────────────────────────
db_instance_class      = "db.r6g.large"
db_allocated_storage   = 100
db_multi_az            = true
db_skip_final_snapshot = false

# ── Redis ──────────────────────────────────────────────────────────────────
redis_node_type       = "cache.r6g.large"
redis_num_cache_nodes = 2

# ── SPARC ──────────────────────────────────────────────────────────────────
sparc_app_name      = "SPARC"
sparc_contact_email = "compliance-team@example.com"
sparc_org_name      = "My Organization"

sparc_enable_oidc         = "true"
sparc_oidc_issuer_url     = "https://your-idp.okta.com"
sparc_oidc_client_id      = "your-client-id"
sparc_oidc_client_secret  = "your-client-secret"
sparc_oidc_provider_title = "Corporate Login (Okta)"
sparc_oidc_force_mfa      = "true"

sparc_enable_smtp       = "true"
sparc_smtp_address      = "smtp.sendgrid.net"
sparc_smtp_port         = "587"
sparc_smtp_username     = "apikey"
sparc_smtp_password     = "CHANGE_ME"
sparc_smtp_from_address = "no-reply@sparc.example.com"

# ── Monitoring ─────────────────────────────────────────────────────────────
alarm_emails = ["ops-team@example.com", "oncall@example.com"]
